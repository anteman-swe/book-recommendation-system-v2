# Basimage
# TODO: Se till att FROM adressen komplementeras för Podman
FROM python:3.10-slim

# Arbetsmapp
WORKDIR /app

# Kopiera beroenden
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopiera kod
COPY . .

# Miljövariabler (kan också sättas via docker-compose)
# TODO: Se över miljövariablerna och flytta till .env
ENV PYTHONPATH=/app
ENV DB_HOST=postgres
ENV DB_NAME=book_db
ENV DB_USER=book_user
ENV DB_PASSWORD=book_password
ENV REDIS_HOST=redis

# Exponera port (FastAPI körs på 8000)
EXPOSE 8000

# Starta FastAPI
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
